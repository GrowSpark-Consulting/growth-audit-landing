# Public site URL used for canonical/Open Graph metadata and payment callbacks.
# Production value: https://growthaudit.growsparkconsulting.com
# For local testing with PayU sandbox callbacks, use your public tunnel URL (e.g., https://abc123.ngrok-free.app).
NEXT_PUBLIC_SITE_URL=https://growthaudit.growsparkconsulting.com

# MongoDB Atlas connection string (SERVER-SIDE ONLY - never expose to browser).
# Replace <username>, <password>, and <cluster> with your Atlas cluster details.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/growth_audit?retryWrites=true&w=majority
MONGODB_DB_NAME=growth_audit

# PayU India credentials (SERVER-SIDE ONLY - never expose to browser).
# Configure distinct credentials for each mode. Production mode never reads test credentials.
PAYU_TEST_MERCHANT_KEY=
PAYU_TEST_MERCHANT_SALT=
PAYU_PRODUCTION_MERCHANT_KEY=
PAYU_PRODUCTION_MERCHANT_SALT=

# PayU Environment: 'test' for sandbox checkout, 'production' for live transactions.
PAYU_MODE=test

# Optional server-side HMAC secret for order verification tokens displayed on /thank-you.
# If omitted, the selected mode's merchant salt is used as the HMAC key.
ORDER_VERIFICATION_SECRET=

# Zoho CRM (SERVER-SIDE ONLY - never add a NEXT_PUBLIC_ prefix).
# Self Client credentials from the Zoho API Console for your data center. The refresh token
# must be generated with the scopes:
# ZohoCRM.modules.leads.ALL,ZohoCRM.modules.notes.CREATE,ZohoCRM.settings.fields.READ
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Accounts server of your Zoho data center (match the domain you use to log in to Zoho CRM):
# https://accounts.zoho.in (India), https://accounts.zoho.com (US), https://accounts.zoho.eu (EU),
# https://accounts.zoho.com.au (AU), https://accounts.zoho.jp (JP), https://accounts.zohocloud.ca (CA)
ZOHO_ACCOUNTS_URL=
# Optional Zoho CRM REST API version. Defaults to v8.
ZOHO_API_VERSION=

# Bearer secret for the CRM retry job at /api/internal/zoho-sync-retry.
# Vercel Cron sends it automatically. Use a long random value.
CRON_SECRET=

# Free landing page (optional). Defaults to the production free host.
# NEXT_PUBLIC_FREE_SITE_URL=https://growthaudit-free.growsparkconsulting.com

# Meta Pixel + Conversions API. Leave the Pixel ID empty to disable all Meta tracking
# (no consent banner is shown then). The Pixel ID is public; it is inlined at build time,
# so redeploy after changing it.
NEXT_PUBLIC_META_PIXEL_ID=
# Conversions API access token (SERVER-SIDE ONLY - never add a NEXT_PUBLIC_ prefix).
META_CAPI_ACCESS_TOKEN=
# Optional: Events Manager -> Test Events code. Set only while testing, then remove.
META_TEST_EVENT_CODE=
# Optional Graph API version for the Conversions API. Defaults to v24.0.
META_GRAPH_API_VERSION=
